# Model weights. docker-compose mounts ./sybil_checkpoints from the host, so after the first start
# that folder holds the checkpoints (~700 MB): `COPY . .` must not copy them into the image, where
# the mount would hide them anyway.
sybil_checkpoints/*
!sybil_checkpoints/.gitignore

